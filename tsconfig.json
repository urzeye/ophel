{
  "extends": "plasmo/templates/tsconfig.base.json",
  "exclude": ["node_modules"],
  "include": [
    ".plasmo/index.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "tests/**/*.ts",
  ],
  "compilerOptions": {
    "paths": {
      "~*": ["./src/*"],
    },
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
  },
}
